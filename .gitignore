# Environments
.venv/
env/
__pycache__/
*.pyc

# Raw / large data — never commit audio or raw EEG
data_raw/**
!data_raw/README_access.md
!data_raw/.gitkeep
!data_raw/ds002721_stimulus_audit.csv
data_interim/**
!data_interim/.gitkeep
data_processed/**
!data_processed/.gitkeep

# Results -- keep small summary CSVs (they're tiny and human-readable);
# large regenerable outputs (figures, model files) stay ignored
results/**
!results/.gitkeep
!results/*.csv 
# Quick/integration-test CSVs are reproducible scratch artifacts. Keep the test
# source code, but do not let repeated validation runs clutter version control.
results/*_test*.csv

# OS / editor
.DS_Store
.ipynb_checkpoints/
*.log 

# Local rendering and one-off build scratch directories.
tmp/
.tmp_*/
